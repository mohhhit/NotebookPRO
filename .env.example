# API Keys (optional - for using external models)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
# RAG Mode: Uses pre-trained models with retrieval (recommended)
MODEL_NAME=microsoft/phi-2
USE_PRETRAINED=true
# Fine-tuned Model Path (only if you trained your own model)
MODEL_PATH=./models/trained_model
VECTOR_DB_PATH=./data/vector_db

# Local Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Application Settings
MAX_UPLOAD_SIZE=200
TEMPERATURE=0.7
MAX_TOKENS=2048
FOLLOWUP_MODEL=mistralai/mistral-7b-instruct-v0.3
GROQ_FOLLOWUP_MODEL=openai/gpt-oss-20b

# Space-switch memory cleanup (optional)
SPACE_SWITCH_CLEAR_CUDA_CACHE=true
SPACE_SWITCH_UNLOAD_EMBEDDING_MODEL=false
