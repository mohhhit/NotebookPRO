<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="NotebookPRO"
      Manufacturer="NotebookPRO"
      Version="1.0.0.0"
      UpgradeCode="9A1F7A8B-1F24-4AF5-9D0A-0A5D4B75B2C1"
      Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NotebookPRO is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="NotebookPRO">
        <Directory Id="BACKENDFOLDER" Name="backend" />
        <Directory Id="PYTHONFOLDER" Name="python" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONFOLDER" Name="NotebookPRO" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="NotebookPRO" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="BackendFiles" />
      <ComponentGroupRef Id="PythonFiles" />
      <ComponentGroupRef Id="MiscFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- Define the Custom Action to install deps silently -->
    <CustomAction Id="InstallPythonDeps" 
                  Directory="INSTALLFOLDER" 
                  ExeCommand="wscript.exe &quot;[INSTALLFOLDER]run_hidden.vbs&quot; &quot;cmd.exe /c &quot;&quot;[INSTALLFOLDER]install_deps.bat&quot;&quot;&quot;" 
                  Execute="deferred" 
                  Impersonate="yes" 
                  Return="check" />

    <InstallExecuteSequence>
        <Custom Action="InstallPythonDeps" Before="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.FlutterDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="BackendFiles" Directory="BACKENDFOLDER">
      <Files Include="$(var.BackendDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="PythonFiles" Directory="PYTHONFOLDER">
      <Files Include="$(var.PythonDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="MiscFiles" Directory="INSTALLFOLDER">
      <File Source="$(var.MiscDir)\install_deps.bat" />
      <File Source="$(var.MiscDir)\requirements.txt" />
      <File Source="$(var.MiscDir)\run_hidden.vbs" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="APPLICATIONFOLDER" Guid="*">
      <Shortcut Id="StartMenuShortcut" Name="NotebookPRO" Target="[INSTALLFOLDER]notebook_pro_app.exe" WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\NotebookPRO" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
